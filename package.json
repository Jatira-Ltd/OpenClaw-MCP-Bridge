{
  "name": "@openclaw/mcp-bridge",
  "version": "1.0.0",
  "description": "MCP Bridge for OpenClaw - Connect to Model Context Protocol servers",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-bridge": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:cli": "npx esbuild src/cli.tsx --bundle --platform=node --outfile=dist/cli.js --external:child_process --external:react --external:react-dom --external:ink --external:enquirer --external:chalk --external:ora --external:@modelcontextprotocol/sdk --external:enquirer --external:pino --external:pino-pretty --format=esm --loader:.tsx=tsx",
    "build:all": "npm run build && npm run build:cli",
    "start": "node dist/index.js",
    "dev": "npm run build:all && node dist/cli.js",
    "cli": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openclaw",
    "bridge"
  ],
  "author": "OpenClaw",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "enquirer": "^2.4.1",
    "ink": "^6.8.0",
    "ora": "^7.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^10.3.1",
    "prompter": "^0.0.5",
    "react": "^19.2.4",
    "react-devtools-core": "^6.0.8"
  },
  "devDependencies": {
    "@aashari/mcp-server-atlassian-jira": "^3.3.0",
    "@apify/actors-mcp-server": "^0.9.7",
    "@azure-devops/mcp": "^2.4.0",
    "@azure/mcp": "^2.0.0-beta.25",
    "@dynatrace-oss/dynatrace-mcp-server": "^1.5.2",
    "@fast-kit/spec-kit": "^0.1.0",
    "@heroku/mcp-server": "^1.2.0",
    "@hubspot/mcp-server": "^0.4.0",
    "@mapbox/mcp-server": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@modelcontextprotocol/server-memory": "^2026.1.26",
    "@modelcontextprotocol/server-sequential-thinking": "^2025.12.18",
    "@railway/mcp-server": "^0.1.8",
    "@roychri/mcp-server-asana": "^1.7.0",
    "@sentry/mcp-server": "^0.29.0",
    "@stripe/mcp": "^0.3.1",
    "@structured-world/gitlab-mcp": "^5.7.0",
    "@supabase/mcp-server-supabase": "^0.7.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@ui5/mcp-server": "^0.2.8",
    "@upstash/context7-mcp": "^2.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@winor30/mcp-server-datadog": "^1.7.0",
    "@zereight/mcp-gitlab": "^2.0.30",
    "chrome-devtools-mcp": "^0.19.0",
    "esbuild": "^0.27.3",
    "eslint": "^8.57.0",
    "figma-mcp": "^0.1.4",
    "ink-testing-library": "^4.0.0",
    "linear-mcp": "^1.2.0",
    "mcp-server-code-runner": "^0.1.8",
    "mcp-server-kubernetes": "^3.3.0",
    "puppeteer-mcp-server": "^0.7.2",
    "ref-tools-mcp": "^3.0.3",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
